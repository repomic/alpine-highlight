{
	"name": "alpine-highlight",
	"displayName": "Alpine Highlight",
	"version": "0.0.3",
	"publisher": "repomic",
	"engines": {
		"vscode": "^1.60.0"
	},
	"categories": [
		"Programming Languages"
	],
	"contributes": {
		"grammars": [
			{
				"scopeName": "custom-js-tag.injection",
				"path": "./syntax/injection.json",
				"injectTo": [
					"text.html.php.blade",
					"text.html.php",
					"text.html.derivative",
					"text.html.basic"
				],
				"embeddedLanguages": {
					"meta.embedded.block.javascript": "javascript",
					"meta.embedded.line.php": "php"
				}
			}
		]
	}
}